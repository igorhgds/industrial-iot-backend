# Database Credentials (PostgreSQL / TimescaleDB)
POSTGRES_DB=industrial_iiot_db
POSTGRES_USER=iiot_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Broker Credentials (RabbitMQ)
RABBITMQ_DEFAULT_USER=iiot
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Broker Credentials (Mosquitto MQTT)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=industrial-backend-consumer
MQTT_TELEMETRY_TOPIC=industry/machinery/+